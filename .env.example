# Copy this file to .env and fill in your own id. .env is gitignored.
#
# DSN_ACCOUNT_ID is the numeric part of your SteamID3, written [U:1:N] — the N.
# steamid.io shows it as "steamID3". If you only have the 64-bit id:
#
#   account_id = steamid64 - 76561197960265728
#
# Without this the proxy still starts, but /state stays IDLE and no live match
# is ever detected. That is deliberate: the upstream endpoint ignores a zero
# account id and returns every active match, so an unconfigured proxy would
# broadcast a stranger's game.
DSN_ACCOUNT_ID=

# Shown in the bar across the top of the overlay. Both optional - the bar keeps
# its height either way, because that height is what makes the gameplay area a
# true 16:9. Leave them blank and the bar renders empty.
DSN_STREAMER_NAME=
DSN_STREAMER_TAGLINE=

# Port for the proxy and the overlay. Change it here and in your OBS browser
# source URL together.
#PORT=7331
