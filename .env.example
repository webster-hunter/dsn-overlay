# Copy this file to .env and fill in your own id. .env is gitignored.
#
# DSN_ACCOUNT_ID takes any Steam identifier for your account — whichever one you
# happen to have, it is converted for you:
#
#   123456788            Friend Code (Steam shows this in your profile)
#   76561198083722516     SteamID64, the number in a profile URL
#   [U:1:123456788]      SteamID3, what steamid.io calls it
#   STEAM_0:0:61728394   the legacy form
#
# On startup the proxy prints the account id it resolved, so you can confirm it
# understood what you pasted.
#
# Without this the proxy still starts, but /state stays IDLE and no live match
# is ever detected. That is deliberate: the upstream endpoint ignores a zero
# account id and returns every active match, so an unconfigured proxy would
# broadcast a stranger's game.
DSN_ACCOUNT_ID=

# Shown in the bar across the top of the overlay. Both optional - the bar keeps
# its height either way, because that height is what makes the gameplay area a
# true 16:9. Leave them blank and the bar renders empty.
DSN_STREAMER_NAME=
DSN_STREAMER_TAGLINE=

# The channel whose chat fills the right rail. Read-only: the overlay connects
# anonymously and cannot send, so nothing can be typed from the broadcast.
#
# Twitch emotes, BetterTTV emotes (global + this channel's) and HOST/MOD/VIP/SUB
# badges all work with no key and nothing else to configure. Leave this blank
# and the rail shows a placeholder card instead.
DSN_TWITCH_CHANNEL=

# Port for the proxy and the overlay. Change it here and in your OBS browser
# source URL together.
#PORT=7331
